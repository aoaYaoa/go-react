[Unit]
Description=Go React remote deployment trigger
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apps/go-react
ExecStart=/usr/local/bin/go-react-boot-update.sh
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
